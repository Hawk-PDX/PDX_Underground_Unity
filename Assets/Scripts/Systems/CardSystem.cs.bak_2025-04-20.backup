using System;
using System.Collections.Generic;
using System.Linq;
using PDXUnderground.Core;
using PDXUnderground.Core.Interfaces;
using PDXUnderground.Models;
using PDXUnderground.Models.Interfaces;
using ICard = PDXUnderground.Models.Interfaces.ICard;  // Explicit alias to resolve ambiguity

namespace PDXUnderground.Systems
{
    /// <summary>
    /// Implementation of the card system used by the gambler character.
    /// Manages card drawing, usage, and cooldowns with O(1) operations.
    /// </summary>
    [AddComponentMenu("PDX Underground/Card System")]
    public class CardSystem : MonoBehaviour, ICardSystem, ICardController
    {
        #region Fields
        // Card management
        private List<ICard> _currentHand = new List<ICard>();
        private IDeckManager _deckManager;
        private UnityEngine.Object _deckManagerObject;
        private int _maxHandSize = 5;
        
        // Gambler abilities data
        private static class GamblerAbilities
        {
            public const string Slice = "Slice";
            public const string Flick = "Flick";
            public const string DealersChoice = "Dealer's Choice";

            public static readonly Dictionary<string, CardDefinition> Abilities = new Dictionary<string, CardDefinition>
            {
                {
                    Slice,
                    new CardDefinition
                    {
                        Name = Slice,
                        Type = CardType.Attack,
                        EnergyCost = 2f,
                        Cooldown = 1.5f,
                        Damage = 8f,
                        Description = "A quick slash attack",
                        SpecialEffect = SpecialEffect.None
                    }
                },
                {
                    Flick,
                    new CardDefinition
                    {
                        Name = Flick,
                        Type = CardType.Attack,
                        EnergyCost = 1f,
                        Cooldown = 1f,
                        Damage = 5f,
                        Description = "A rapid card throw",
                        SpecialEffect = SpecialEffect.None
                    }
                },
                {
                    DealersChoice,
                    new CardDefinition
                    {
                        Name = DealersChoice,
                        Type = CardType.Special,
                        EnergyCost = 5f,
                        Cooldown = 15f,
                        Damage = 0f,
                        Description = "Deal 5 cards and gain power based on hand value",
                        SpecialEffect = SpecialEffect.DealersChoice
                    }
                }
            };
        }
        
        // Energy management
        private float _playerEnergy = 100f;
        private float _maxPlayerEnergy = 100f;
        private float _energyRegenRate = 10f;

        /// <summary>
        /// Dictionary to track ability cooldowns
        /// </summary>
        private Dictionary<string, float> _abilityCooldowns = new Dictionary<string, float>();

        /// <summary>
        /// Whether the system has been properly initialized
        /// </summary>
        private bool _isInitialized = false;
        #endregion

        #region Properties
        // Properties that implement interface requirements
        public ICard[] CurrentHand => _currentHand.ToArray();
        public ICard[] Deck => _deckManager?.GetAllCards()?.ToArray() ?? Array.Empty<ICard>();
        public int MaxHandSize => _maxHandSize;
        #endregion

        #region Events
        // Public event declarations that implement interface requirements
        public event Action<ICard> OnCardUsed;
        public event Action<ICard> OnCardDiscarded;
        public event Action<ICard> OnCardDrawn;
        public event Action<List<ICard>> OnHandChanged;
        public event Action<string, float> OnAbilityUsed;
        public event Action<Vector3> OnCriticalHit;
        #endregion

        /// <summary>
        /// Helper enum for card event types
        /// </summary>
        private enum CardEventType
        {
            Used,
            Drawn,
            Discarded
        }
        
        /// <summary>
        /// Subscribe to events
        /// </summary>
        private void OnEnable()
        {
            // Subscribe to any external events here
        }

        /// <summary>
        /// Unsubscribe from events
        /// </summary>
        private void OnDisable()
        {
            // Unsubscribe from any external events here
        }

        /// <summary>
        /// Update energy regeneration
        /// </summary>
        private void Update()
        {
            if (!_isInitialized)
                return;

            if (_playerEnergy < _maxPlayerEnergy)
            {
                float energyToAdd = _energyRegenRate * Time.deltaTime;
                _playerEnergy = Mathf.Min(_playerEnergy + energyToAdd, _maxPlayerEnergy);
            }
        }
        
        /// <summary>
        /// Initialize deck manager component
        /// </summary>
        private void InitializeDeckManager()
        {
            if (_deckManagerObject != null)
            {
                _deckManager = _deckManagerObject as IDeckManager;
                if (_deckManager == null)
                {
                    Debug.LogError("CardSystem: Deck manager object must implement IDeckManager interface");
                    return;
                }
                _isInitialized = true;
            }
            else
            {
                Debug.LogWarning("CardSystem: No deck manager assigned, will use fallback card generation");
                _isInitialized = true; // Still allow system to work with fallback
            }
        }
        
        #region Public Methods
        // Public methods implementing both interfaces
        public void UseCard(ICard card) => UseCardImplementation(card);
        public bool UseCard(int cardIndex) => UseCardImplementationWithBool(cardIndex);
        public bool UseCard(int cardIndex, Vector3 direction) => UseCardImplementationWithDirectionAndBool(cardIndex, direction);
        public void UseCard(ICard card, Vector3 direction) => UseCardImplementationWithDirection(card, direction);
        public void DiscardCard(ICard card) => DiscardCardImplementation(card);
        public bool CanUseCard(ICard card) => IsCardPlayable(card);
        public float GetCardCooldown(ICard card) => GetCardCooldownImplementation(card);
        public bool IsCardOnCooldown(ICard card) => IsCardOnCooldownImplementation(card);
        public List<ICard> GetCurrentHand() => new List<ICard>(_currentHand);
        public void DrawCard() => DrawCardImplementation(null);
        public void DrawCard(ICard card) => DrawCardImplementation(card);
        public void ShuffleDeck() => ShuffleDeckImplementation();
        public float GetAbilityCooldown(string abilityName) => GetAbilityCooldownImplementation(abilityName);
        
        // Additional public methods
        public void DrawCard(ICard card, Vector3 position)
        {
            DrawCardImplementation(card);
            // Additional position-based logic could be implemented here if needed
        }

        /// <summary>
        /// Use an ability by name, optionally with a direction
        /// </summary>
        private void UseAbility(string abilityName, Vector3? direction = null)
        {
            var card = _currentHand.FirstOrDefault(c => c.Name == abilityName);
            if (card != null)
            {
                if (direction.HasValue)
                {
                    UseCardImplementationWithDirection(card, direction.Value);
                }
                else
                {
                    UseCardImplementation(card);
                }
            }
            else
            {
                Debug.LogWarning($"CardSystem: No card found with ability name {abilityName}");
            }
        }

        public float GetEnergyCost(string abilityName)
        {
            var card = _currentHand.FirstOrDefault(c => c.Name == abilityName);
            return card?.EnergyCost ?? -1f;
        }

        public bool HasCard(string cardName)
        {
            return _currentHand.Any(c => c.Name == cardName);
        }

        public int GetHandSize()
        {
            return _currentHand.Count;
        }

        public int GetMaxHandSize()
        {
            return _maxHandSize;
        }

        private void UseCardByName(string cardName)
        {
            var card = _currentHand.FirstOrDefault(c => c.Name == cardName);
            if (card != null)
            {
                UseCardImplementation(card);
            }
            else
            {
                Debug.LogWarning($"CardSystem: No card found with name {cardName}");
            }
        }

        public List<string> GetAvailableAbilities()
        {
            return _currentHand.Select(card => card.Name).ToList();
        }

        public bool HasAbility(string abilityName)
        {
            return _currentHand.Any(c => c.Name == abilityName);
        }

        public float GetCurrentEnergy()
        {
            return _playerEnergy;
        }

        public float GetMaximumEnergy()
        {
            return _maxPlayerEnergy;
        }
        #endregion
        
        #region Implementation Methods
        // Private implementations
        private void UseCardImplementation(ICard card)
        {
            if (!IsCardPlayable(card))
            {
                Debug.LogWarning($"CardSystem: Card {card.Name} cannot be played (cooldown or energy)");
                return;
            }
            // Apply card effect
            UseCardEffect(card);

            // Update card state including event triggers
            UpdateCardAfterUse(card);
        }

        private bool UseCardImplementationWithBool(int cardIndex)
        {
            if (cardIndex < 0 || cardIndex >= _currentHand.Count)
                return false;
                
            var card = _currentHand[cardIndex];
            if (!IsCardPlayable(card))
                return false;
                
            UseCardEffect(card);
            UpdateCardAfterUse(card, cardIndex);
            return true;
        }

        private void UseCardImplementationWithDirection(ICard card, Vector3 direction)
        {
            if (!IsCardPlayable(card))
                return;
                
            UseCardEffectWithDirection(card, direction);
            UpdateCardAfterUse(card);
        }

        private void UseCardImplementationWithDirection(int cardIndex, Vector3 direction)
        {
            if (cardIndex < 0 || cardIndex >= _currentHand.Count)
                return;
                
            var card = _currentHand[cardIndex];
            if (!IsCardPlayable(card))
                return;
                
            UseCardEffectWithDirection(card, direction);
            UpdateCardAfterUse(card, cardIndex);
        }

        private bool UseCardImplementationWithDirectionAndBool(int cardIndex, Vector3 direction)
        {
            if (cardIndex < 0 || cardIndex >= _currentHand.Count)
                return false;
                
            var card = _currentHand[cardIndex];
            if (!IsCardPlayable(card))
                return false;
                
            UseCardEffectWithDirection(card, direction);
            UpdateCardAfterUse(card, cardIndex);
            return true;
        }
        
        private void UpdateCardAfterUse(ICard card, int? indexInHand = null)
        {
            if (card == null)
                return;
                
            // Update card state
            UpdateCardState(card);

            // Handle card removal if needed
            if (ShouldRemoveCardAfterUse(card))
            {
                if (indexInHand.HasValue && indexInHand >= 0 && indexInHand < _currentHand.Count)
                {
                    _currentHand.RemoveAt(indexInHand.Value);
                }
                else
                {
                    _currentHand.Remove(card);
                }
                TriggerCardEvents(card, CardEventType.Discarded);
            }
            
            // Trigger card used events
            TriggerCardEvents(card, CardEventType.Used);
            OnAbilityUsed?.Invoke(card.Name, card.Cooldown);
        }
        
        /// <summary>
        /// Updates the state of a card after use
        /// </summary>
        private void UpdateCardState(ICard card)
        {
            card.LastUseTime = Time.time;
            ModifyEnergy(-card.EnergyCost);
            _abilityCooldowns[card.Name] = Time.time;
        }
        
        /// <summary>
        /// Triggers appropriate events for card operations
        /// </summary>
        private void TriggerCardEvents(ICard card, CardEventType eventType)
        {
            switch (eventType)
            {
                case CardEventType.Used:
                    OnCardUsed?.Invoke(card);
                    break;
                case CardEventType.Drawn:
                    OnCardDrawn?.Invoke(card);
                    break;
                case CardEventType.Discarded:
                    OnCardDiscarded?.Invoke(card);
                    break;
            }
            // Always notify of hand changes for card operations
            // Create a new list for the event to maintain encapsulation
            OnHandChanged?.Invoke(new List<ICard>(_currentHand));
        }
        
        /// <summary>
        /// Check if a card can be used
        /// </summary>
        private bool IsCardPlayable(ICard card)
        {
            if (card == null)
                return false;
                
            return (Time.time - card.LastUseTime > card.Cooldown) && HasEnoughEnergy(card);
        }
        
        private void DiscardCardImplementation(ICard card)
        {
            if (card != null && _currentHand.Contains(card))
            {
                _currentHand.Remove(card);
                TriggerCardEvents(card, CardEventType.Discarded);
            }
        }
        
