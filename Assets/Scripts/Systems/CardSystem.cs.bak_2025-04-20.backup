                        Description = "Deal 5 cards and gain power based on hand value",
                        SpecialEffect = SpecialEffect.DealersChoice
                    }
                }
            };
        }
        
        // Energy management
        private float _playerEnergy = 100f;
        private float _maxPlayerEnergy = 100f;
        private float _energyRegenRate = 10f;

        /// <summary>
        /// Dictionary to track ability cooldowns
        /// </summary>
        private Dictionary<string, float> _abilityCooldowns = new Dictionary<string, float>();
        /// <summary>
        /// Whether the system has been properly initialized
        /// </summary>
        private bool _isInitialized = false;
        #endregion

        #region Properties
        // Properties that implement interface requirements
        public ICard[] CurrentHand => _currentHand.ToArray();
        public ICard[] Deck => _deckManager?.GetAllCards()?.ToArray() ?? Array.Empty<ICard>();
        public int MaxHandSize => _maxHandSize;
        #endregion

        #region Events
        // Public event declarations that implement interface requirements
        public event Action<ICard> OnCardUsed;
        public event Action<ICard> OnCardDiscarded;
        public event Action<ICard> OnCardDrawn;
        public event Action<List<ICard>> OnHandChanged;
        public event Action<string, float> OnAbilityUsed;
        public event Action<Vector3> OnCriticalHit;
        #endregion

        /// <summary>
        /// Helper enum for card event types
        /// </summary>
        private enum CardEventType
        {
            Used,
            Drawn,
            Discarded
        }
        
        /// <summary>
        /// Subscribe to events
        /// </summary>
        private void OnEnable()
        {
            // Subscribe to any external events here
        }

        /// <summary>
        /// Unsubscribe from events
        /// </summary>
        private void OnDisable()
        {
            // Unsubscribe from any external events here
        }

        /// <summary>
        /// Update energy regeneration
        /// </summary>
        private void Update()
        {
            if (!_isInitialized)
                return;

            if (_playerEnergy < _maxPlayerEnergy)
            {
                float energyToAdd = _energyRegenRate * Time.deltaTime;
                _playerEnergy = Mathf.Min(_playerEnergy + energyToAdd, _maxPlayerEnergy);
            }
        }
        
        /// <summary>
        /// Initialize deck manager component
        /// </summary>
        /// </summary>
        private void InitializeDeckManager()
        {
            if (_deckManagerObject != null)
            {
                _deckManager = _deckManagerObject as IDeckManager;
                if (_deckManager == null)
                {
                    Debug.LogError("CardSystem: Deck manager object must implement IDeckManager interface");
                    return;
                }
                _isInitialized = true;
            }
            else
            {
                Debug.LogWarning("CardSystem: No deck manager assigned, will use fallback card generation");
                _isInitialized = true; // Still allow system to work with fallback
            }
        }
        
        #region Public Methods
        // Public methods implementing both interfaces
        public void UseCard(ICard card) => UseCardImplementation(card);
        public bool UseCard(int cardIndex) => UseCardImplementationWithBool(cardIndex);
        public bool UseCard(int cardIndex, Vector3 direction) => UseCardImplementationWithDirectionAndBool(cardIndex, direction);
        public void UseCard(ICard card, Vector3 direction) => UseCardImplementationWithDirection(card, direction);
        public void DiscardCard(ICard card) => DiscardCardImplementation(card);
        public bool CanUseCard(ICard card) => IsCardPlayable(card);
        public float GetCardCooldown(ICard card) => GetCardCooldownImplementation(card);
        public bool IsCardOnCooldown(ICard card) => IsCardOnCooldownImplementation(card);
        public List<ICard> GetCurrentHand() => new List<ICard>(_currentHand);
        public void DrawCard() => DrawCardImplementation(null);
        public void DrawCard(ICard card) => DrawCardImplementation(card);
        public void ShuffleDeck() => ShuffleDeckImplementation();
        public float GetAbilityCooldown(string abilityName) => GetAbilityCooldownImplementation(abilityName);
        
        // Additional public methods
        public void DrawCard(ICard card, Vector3 position)
        {
            DrawCardImplementation(card);
            // Additional position-based logic could be implemented here if needed
        }

        /// <summary>
        /// Use an ability by name, optionally with a direction
        /// </summary>
        private void UseAbility(string abilityName, Vector3? direction = null)
        {
            var card = _currentHand.FirstOrDefault(c => c.Name == abilityName);
            if (card != null)
            {
                if (direction.HasValue)
                {
                    UseCardImplementationWithDirection(card, direction.Value);
                }
                else
                {
                    UseCardImplementation(card);
                }
            }
            else
            {
                Debug.LogWarning($"CardSystem: No card found with ability name {abilityName}");
            }
        }

        public float GetEnergyCost(string abilityName)
        {
            var card = _currentHand.FirstOrDefault(c => c.Name == abilityName);
            return card?.EnergyCost ?? -1f;
        }

        public bool HasCard(string cardName)
        {
            return _currentHand.Any(c => c.Name == cardName);
        }

        public int GetHandSize()
        {
            return _currentHand.Count;
        }

        public int GetMaxHandSize()
        {
            return _maxHandSize;
        }

        private void UseCardByName(string cardName)
        {
            var card = _currentHand.FirstOrDefault(c => c.Name == cardName);
            if (card != null)
            {
                UseCardImplementation(card);
            }
            else
            {
                Debug.LogWarning($"CardSystem: No card found with name {cardName}");
            }
        }


        public List<string> GetAvailableAbilities()
        {
            return _currentHand.Select(card => card.Name).ToList();
        }

        public bool HasAbility(string abilityName)
        {
            return _currentHand.Any(c => c.Name == abilityName);
        }

        public float GetCurrentEnergy()
        {
            return _playerEnergy;
        }

        public float GetMaximumEnergy()
        {
            return _maxPlayerEnergy;
        }
        #endregion
        
        #region Implementation Methods
        // Private implementations
        private void UseCardImplementation(ICard card)
        {
            if (!IsCardPlayable(card))
            {
                Debug.LogWarning($"CardSystem: Card {card.Name} cannot be played (cooldown or energy)");
                return;
            }
            // Apply card effect
            UseCardEffect(card);

            // Update card state including event triggers
            UpdateCardAfterUse(card);
        }

        private bool UseCardImplementationWithBool(int cardIndex)
        {
            if (cardIndex < 0 || cardIndex >= _currentHand.Count)
                return false;
                
            var card = _currentHand[cardIndex];
            if (!IsCardPlayable(card))
                return false;
                
            UseCardEffect(card);
            UpdateCardAfterUse(card, cardIndex);
            return true;
        }

        private void UseCardImplementationWithDirection(ICard card, Vector3 direction)
        {
            if (!IsCardPlayable(card))
                return;
                
            UseCardEffectWithDirection(card, direction);
            UpdateCardAfterUse(card);
        }

        private void UseCardImplementationWithDirection(int cardIndex, Vector3 direction)
        {
            if (cardIndex < 0 || cardIndex >= _currentHand.Count)
                return;
                
            var card = _currentHand[cardIndex];
            if (!IsCardPlayable(card))
                return;
                
            UseCardEffectWithDirection(card, direction);
            UpdateCardAfterUse(card, cardIndex);
        }

        private bool UseCardImplementationWithDirectionAndBool(int cardIndex, Vector3 direction)
        {
            if (cardIndex < 0 || cardIndex >= _currentHand.Count)
                return false;
                
            var card = _currentHand[cardIndex];
            if (!IsCardPlayable(card))
                return false;
                
            UseCardEffectWithDirection(card, direction);
            UpdateCardAfterUse(card, cardIndex);
            return true;
        }
        
        private void UpdateCardAfterUse(ICard card, int? indexInHand = null)
        {
            if (card == null)
                return;
                
            // Update card state
            UpdateCardState(card);

            // Handle card removal if needed
            if (ShouldRemoveCardAfterUse(card))
            {
                if (indexInHand.HasValue && indexInHand >= 0 && indexInHand < _currentHand.Count)
                {
                    _currentHand.RemoveAt(indexInHand.Value);
                }
                else
                {
                    _currentHand.Remove(card);
                }
                TriggerCardEvents(card, CardEventType.Discarded);
            }
            
            // Trigger card used events
            TriggerCardEvents(card, CardEventType.Used);
            OnAbilityUsed?.Invoke(card.Name, card.Cooldown);
        }
        
        /// <summary>
        /// Updates the state of a card after use
        /// </summary>
        private void UpdateCardState(ICard card)
        {
            card.LastUseTime = Time.time;
            ModifyEnergy(-card.EnergyCost);
            _abilityCooldowns[card.Name] = Time.time;
        }
        
        /// <summary>
        /// Triggers appropriate events for card operations
        /// </summary>
        private void TriggerCardEvents(ICard card, CardEventType eventType)
        {
            switch (eventType)
            {
                case CardEventType.Used:
                    OnCardUsed?.Invoke(card);
                    break;
                case CardEventType.Drawn:
                    OnCardDrawn?.Invoke(card);
                    break;
                case CardEventType.Discarded:
                    OnCardDiscarded?.Invoke(card);
                    break;
            }
            // Always notify of hand changes for card operations
            // Create a new list for the event to maintain encapsulation
            OnHandChanged?.Invoke(new List<ICard>(_currentHand));
        }
        
        /// <summary>
        }

        /// <summary>
        /// Get the current player energy
        /// </summary>
        /// <returns>Current energy amount</returns>
        private float GetEnergy()
        {
            return _playerEnergy;
        }

        /// <summary>
        /// Get the maximum player energy
        /// </summary>
        /// <returns>Maximum energy amount</returns>
        private float GetMaxEnergy()
        {
            return _maxPlayerEnergy;
        }

        /// <summary>
        /// Modify player energy
        /// </summary>
        /// <param name="amount">Amount to add (positive) or subtract (negative)</param>
        /// <returns>New energy amount</returns>
        private float ModifyEnergy(float amount)
        {
            _playerEnergy = Mathf.Clamp(_playerEnergy + amount, 0f, _maxPlayerEnergy);
            return _playerEnergy;
        }

        /// <summary>
        /// Check if player has enough energy for a card at specific index
        /// </summary>
        /// <param name="cardIndex">Index of card in hand</param>
        /// <returns>True if player has enough energy</returns>
        private bool HasEnoughEnergy(int cardIndex)
        {
            if (cardIndex < 0 || cardIndex >= _currentHand.Count)
            {
                return false;
            }
            return _playerEnergy >= _currentHand[cardIndex].EnergyCost;
        }

        /// <summary>
        /// Get the energy cost for a card at the specified index
        /// </summary>
        /// <param name="cardIndex">Index of card in hand</param>
        /// <returns>Energy cost, or -1 if index is invalid</returns>
        private float GetEnergyCost(int cardIndex)
        {
            if (cardIndex < 0 || cardIndex >= _currentHand.Count)
            {
                return -1f;
            }
            return _currentHand[cardIndex].EnergyCost;
        }

        /// <summary>
        /// Check if player has enough energy for a specific card
        /// </summary>
        /// <param name="card">Card to check</param>
        /// <returns>True if player has enough energy</returns>
        private bool HasEnoughEnergy(ICard card)
        {
            if (card == null)
            {
                return false;
            }
            return _playerEnergy >= card.EnergyCost;
        }
        
        private float GetCardCooldownImplementation(ICard card)
        {
            if (card == null) return 0f;
            float elapsedTime = Time.time - card.LastUseTime;
            return Mathf.Max(0f, card.Cooldown - elapsedTime);
        }

        private bool IsCardOnCooldownImplementation(ICard card)
        {
            if (card == null) return false;
            return (Time.time - card.LastUseTime) < card.Cooldown;
        }
        
        /// <summary>
        /// Gets the cooldown duration for an ability by checking current
        /// hand or returning default if not found
        /// </summary>
        /// <param name="abilityName">Name of ability</param>
        /// <returns>The cooldown duration in seconds</returns>
        private float GetCooldownDurationForAbility(string abilityName)
        {
            // In a full implementation, this would look up from a card/ability database
            // For now, check the current hand
            var card = _currentHand.FirstOrDefault(c => c.Name == abilityName);
            if (card != null)
            {
                return card.Cooldown;
            }
            
            // Check the Gambler abilities dictionary
            if (GamblerAbilities.Abilities.TryGetValue(abilityName, out var definition))
            {
                return definition.Cooldown;
            }
            
            // Return a default cooldown if not found
            return 5f;
        }
        
        /// <summary>
        /// Implementation of DrawCard method
        /// </summary>
        private void DrawCardImplementation(ICard card)
        {
            if (_currentHand.Count >= _maxHandSize)
            {
                Debug.LogWarning("CardSystem: Hand is full, cannot draw more cards");
                return;
            }
            
            if (card == null)
            {
                // Draw random card
                var newCard = GenerateCard();
                if (newCard != null)
                {
                    _currentHand.Add(newCard);
                    TriggerCardEvents(newCard, CardEventType.Drawn);
                }
            }
            else
            {
                // Draw specific card
                _currentHand.Add(card);
                TriggerCardEvents(card, CardEventType.Drawn);
            }
        }
        
        /// <summary>
        /// Apply card effect based on card type
        /// </summary>
        /// <param name="card">The card to apply the effect for</param>
        private void UseCardEffect(ICard card)
        {
            HandleCardEffect(card);
        }
        
        /// <summary>
        /// Gets the current hand of cards
        /// </summary>
        /// <returns>New list with current hand cards</returns>
        private List<ICard> GetCurrentHandImplementation() 
        {
            return new List<ICard>(_currentHand);
        }
        
        private void HandleCardEffect(ICard card, Vector3? direction = null)
        {
            if (!IsCardPlayable(card)) return;
            
            try
            {
                switch (card.Type)
                {
                    case CardType.Attack:
                        HandleAttackCard(card, direction);
                        break;
                    case CardType.Defense:
                        HandleDefenseCard(card);
                        break;
                    case CardType.Utility:
                        HandleUtilityCard(card);
                        break;
                    case CardType.Special:
                        HandleSpecialCard(card, direction);
                        break;
                }
            }
            catch (System.Exception e)
            {
                Debug.LogError($"CardSystem: Error handling card effect: {e.Message}");
            }
        }
        
        /// <summary>
        /// Handles attack card effects
        /// </summary>
        private void HandleAttackCard(ICard card, Vector3? direction = null)
        {
            // Process attack card - calls combat system with damage value
            Debug.Log($"CardSystem: Using attack card {card.Name} with {card.Damage} damage");
            // Implementation would call into combat system
            
            if (direction.HasValue)
            {
                Debug.Log($"CardSystem: Attack in direction {direction.Value}");
                OnCriticalHit?.Invoke(direction.Value); // Example event
            }
        }
        
        /// <summary>
        /// Handles defense card effects
        /// </summary>
        private void HandleDefenseCard(ICard card)
        {
            // Process defense card - calls defense system to apply protection
            Debug.Log($"CardSystem: Using defense card {card.Name}");
            // Implementation would call into defense system
        }
        
        /// <summary>
        /// Handles utility card effects
        /// </summary>
        private void HandleUtilityCard(ICard card)
        {
            // Process utility card - applies utility effect (buffs, status changes)
            Debug.Log($"CardSystem: Using utility card {card.Name}");
            // Implementation would call into utility system
        }
        
        /// <summary>
        /// Handles special card effects
        /// </summary>
        private void HandleSpecialCard(ICard card, Vector3? direction = null)
        {
            if (card.Name == GamblerAbilities.DealersChoice)
            {
                // Deal 5 cards
                int cardsToDeal = 5;
                List<ICard> dealtCards = new List<ICard>();
                
                for (int i = 0; i < cardsToDeal; i++)
                {
                    var dealtCard = GenerateCard();
                    if (dealtCard != null)
                    {
                        dealtCards.Add(dealtCard);
                    }
                }

                // Calculate hand value (implement poker hand evaluation)
                float handValue = CalculateHandValue(dealtCards);
                
                // Apply boost based on hand value
                ApplyDealersChoiceBoost(handValue);
            }
            else
            {
                // Process special card - unique one-time effects
                Debug.Log($"CardSystem: Using special card {card.Name}");
                // Implementation would call into special ability system
            }
        }
        
        /// <summary>
        /// Calculate the value of a poker hand
        /// </summary>
        private float CalculateHandValue(List<ICard> cards)
        {
            // Implement poker hand evaluation
            // Return a value between 0 and 1, where:
            // 0.2 = One Pair
            // 0.4 = Two Pair
            // 0.6 = Three of a Kind
            // 0.8 = Straight or Flush
            // 1.0 = Full House or better
            // For now, return a random value
            return UnityEngine.Random.Range(0.2f, 1.0f);
        }

        /// <summary>
        /// Apply boosts based on poker hand value
        /// </summary>
        private void ApplyDealersChoiceBoost(float handValue)
        {
            // Apply boost based on hand value
            float energyBoost = handValue * 50f; // Up to 50 energy
            float damageBoost = handValue * 25f; // Up to 25% damage boost
            
            ModifyEnergy(energyBoost);
            // Apply damage boost (implement in combat system)
            
            Debug.Log($"CardSystem: Dealer's Choice resulted in {handValue} hand value. Energy boost: {energyBoost}, Damage boost: {damageBoost}%");
        }

        /// <summary>
        /// Update cooldowns for all abilities - not actively used as we use Time.time
        /// for cooldown tracking, but provided for future expansion
        /// </summary>
        private void UpdateCooldowns()
        {
            // Since we use Time.time comparison for cooldowns, we don't
            // need to actively update cooldowns in this implementation
            // This method is provided for potential future expansion
            // or for systems that might need to be notified of cooldown changes
        }

        /// <summary>
        /// Determine if a card should be removed after use
        /// </summary>
        /// <param name="card">Card to check</param>
        private bool ShouldRemoveCardAfterUse(ICard card)
        {
            if (card == null)
            {
                return false;
            }

            // Example: Special cards are one-time use, others remain in hand
            return card.Type == CardType.Special;
        }

        /// <summary>
        /// Generate a new card
        /// </summary>
        private ICard GenerateCard()
        {
            if (_deckManager != null)
            {
                var drawnCard = _deckManager.DrawCard();
                if (drawnCard != null) return drawnCard;
            }

            // If no deck manager or it returned null, generate a Gambler ability card or random card
            bool useGamblerAbility = UnityEngine.Random.Range(0, 100) < 70; // 70% chance to use Gambler ability
            
            if (useGamblerAbility)
            {
                // Select a random Gambler ability
                var abilities = GamblerAbilities.Abilities.Values.ToList();
                var definition = abilities[UnityEngine.Random.Range(0, abilities.Count)];
                
                return new Card
                {
                    Id = UnityEngine.Random.Range(1000, 9999),
                    Name = definition.Name,
                    Type = definition.Type,
                    EnergyCost = definition.EnergyCost,
                    Cooldown = definition.Cooldown,
                    Damage = definition.Damage,
                    LastUseTime = 0f,
                    Description = definition.Description,
                    Suit = UnityEngine.Random.Range(0, 4),
                    Rank = UnityEngine.Random.Range(1, 14),
                    SpecialEffect = definition.SpecialEffect
                };
            }
            else
            {
                // Generate a random basic card
                return new Card
                {
                    Id = UnityEngine.Random.Range(1000, 9999),
                    Name = "Basic Card",
                    Type = CardType.Attack,
                    EnergyCost = UnityEngine.Random.Range(1f, 3f),
                    Cooldown = UnityEngine.Random.Range(1f, 3f),
                    Damage = UnityEngine.Random.Range(3f, 8f),
                    LastUseTime = 0f,
                    Description = "A basic card",
                    Suit = UnityEngine.Random.Range(0, 4),
                    Rank = UnityEngine.Random.Range(1, 14),
                    SpecialEffect = SpecialEffect.None
                };
            }
        }

        /// <summary>
        /// Implementation of the ShuffleDeck method
        /// </summary>
        private void ShuffleDeckImplementation()
        {
            if (_deckManager != null)
            {
                _deckManager.ShuffleDeck();
                Debug.Log("CardSystem: Deck shuffled");
            }
            else
            {
                Debug.LogWarning("CardSystem: No deck manager available to shuffle deck");
            }
        }
        #endregion Implementation Methods
        
        /// <summary>
        /// Defines the properties of a card ability
        /// </summary>
        public class CardDefinition
        {
            public string Name { get; set; }
            public CardType Type { get; set; }
            public float EnergyCost { get; set; }
            public float Cooldown { get; set; }
            public float Damage { get; set; }
            public string Description { get; set; }
            public SpecialEffect SpecialEffect { get; set; }
        }
    } // End of class CardSystem
} // End of namespace PDXUnderground.Systems
