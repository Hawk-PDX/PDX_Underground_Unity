using PDXUnderground.Models.Interfaces;
using ICard = PDXUnderground.Models.Interfaces.ICard;  // Explicit alias to resolve ambiguity

namespace PDXUnderground.Systems
{
    /// <summary>
    /// Implementation of the card system used by the gambler character.
    /// Manages card drawing, usage, and cooldowns with O(1) operations.
    /// </summary>
    [AddComponentMenu("PDX Underground/Card System")]
    public class CardSystem : MonoBehaviour, ICardSystem, ICardController
    {
        #region Fields
        // Card management
        private List<ICard> _currentHand = new List<ICard>();
        private IDeckManager _deckManager;
        private UnityEngine.Object _deckManagerObject;
        private int _maxHandSize = 5;
        
        // Gambler abilities data
        private static class GamblerAbilities
        {
            public const string Slice = "Slice";
            public const string Flick = "Flick";
            public const string DealersChoice = "Dealer's Choice";

            public static readonly Dictionary<string, CardDefinition> Abilities = new Dictionary<string, CardDefinition>
            {
                {
                    Slice,
                    new CardDefinition
                    {
                        Name = Slice,
                        Type = CardType.Attack,
                        EnergyCost = 2f,
                        Cooldown = 1.5f,
                        Damage = 8f,
                        Description = "A quick slash attack",
                        SpecialEffect = SpecialEffect.None
                    }
                },
                {
                    Flick,
                    new CardDefinition
                    {
                        Name = Flick,
                        Type = CardType.Attack,
                        EnergyCost = 1f,
                        Cooldown = 1f,
                        Damage = 5f,
                        Description = "A rapid card throw",
                        SpecialEffect = SpecialEffect.None
                    }
                },
                {
                    DealersChoice,
                    new CardDefinition
                    {
                        Name = DealersChoice,
                        Type = CardType.Special,
                        EnergyCost = 5f,
                        Cooldown = 15f,
                        Damage = 0f,
                        Description = "Deal 5 cards and gain power based on hand value",
                        SpecialEffect = SpecialEffect.DealersChoice
                    }
                }
            };
        }
        
        // Energy management
        private float _playerEnergy = 100f;
        private float _maxPlayerEnergy = 100f;
        private float _energyRegenRate = 10f;

        /// <summary>
        /// Dictionary to track ability cooldowns
        /// </summary>
        private Dictionary<string, float> _abilityCooldowns = new Dictionary<string, float>();

        /// <summary>
        /// Whether the system has been properly initialized
        /// </summary>
        private bool _isInitialized = false;
        #endregion

