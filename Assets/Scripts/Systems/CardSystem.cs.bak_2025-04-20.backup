        }

        private bool UseCardImplementationWithDirectionAndBool(int cardIndex, Vector3 direction)
        {
            if (cardIndex < 0 || cardIndex >= _currentHand.Count)
                return false;
                
            var card = _currentHand[cardIndex];
            if (!IsCardPlayable(card))
                return false;
                
            UseCardEffectWithDirection(card, direction);
            UpdateCardAfterUse(card, cardIndex);
            return true;
        }
        
        private void UpdateCardAfterUse(ICard card, int? indexInHand = null)
        {
            if (card == null)
                return;
                
            // Update card state
            UpdateCardState(card);

            // Handle card removal if needed
            if (ShouldRemoveCardAfterUse(card))
            {
                if (indexInHand.HasValue && indexInHand >= 0 && indexInHand < _currentHand.Count)
                {
                    _currentHand.RemoveAt(indexInHand.Value);
