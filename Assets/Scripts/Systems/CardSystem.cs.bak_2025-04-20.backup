namespace PDXUnderground.Systems
{
    /// <summary>
    /// Implementation of the card system used by the gambler character.
    /// Manages card drawing, usage, and cooldowns with O(1) operations.
    /// </summary>
    [AddComponentMenu("PDX Underground/Card System")]
    public class CardSystem : MonoBehaviour, ICardSystem, ICardController
    {
        #region Fields
        // Card management
        private List<ICard> _currentHand = new List<ICard>();
        private IDeckManager _deckManager;
        private UnityEngine.Object _deckManagerObject;
        private int _maxHandSize = 5;
        
        // Gambler abilities data
        private static class GamblerAbilities
        {
            public const string Slice = "Slice";
            public const string Flick = "Flick";
            public const string DealersChoice = "Dealer's Choice";

            public static readonly Dictionary<string, CardDefinition> Abilities = new Dictionary<string, CardDefinition>
            {
                {
                    Slice,
                    new CardDefinition
                    {
                        Name = Slice,
                        Type = CardType.Attack,
                        EnergyCost = 2f,
                        Cooldown = 1.5f,
                        Damage = 8f,
                        Description = "A quick slash attack",
                        SpecialEffect = SpecialEffect.None
                    }
                },
                {
                    Flick,
                    new CardDefinition
                    {
                        Name = Flick,
                        Type = CardType.Attack,
                        EnergyCost = 1f,
                        Cooldown = 1f,
                        Damage = 5f,
                        Description = "A rapid card throw",
                        SpecialEffect = SpecialEffect.None
                    }
                },
                {
                    DealersChoice,
                    new CardDefinition
                    {
                        Name = DealersChoice,
                        Type = CardType.Special,
                        EnergyCost = 5f,
                        Cooldown = 15f,
                        Damage = 0f,
                        Description = "Deal 5 cards and gain power based on hand value",
                        SpecialEffect = SpecialEffect.DealersChoice
                    }
                }
            };
        }
        
        // Energy management
        private float _playerEnergy = 100f;
        private float _maxPlayerEnergy = 100f;
        private float _energyRegenRate = 10f;

        /// <summary>
        /// Dictionary to track ability cooldowns
        /// </summary>
        private Dictionary<string, float> _abilityCooldowns = new Dictionary<string, float>();

        /// <summary>
        /// Whether the system has been properly initialized
        /// </summary>
        private bool _isInitialized = false;
        #endregion

        #region Properties
        // Properties that implement interface requirements
        public ICard[] CurrentHand => _currentHand.ToArray();
        public ICard[] Deck => _deckManager?.GetAllCards()?.ToArray() ?? Array.Empty<ICard>();
        public int MaxHandSize => _maxHandSize;
        #endregion

        #region Events
        // Public event declarations that implement interface requirements
        public event Action<ICard> OnCardUsed;
        public event Action<ICard> OnCardDiscarded;
        public event Action<ICard> OnCardDrawn;
        public event Action<List<ICard>> OnHandChanged;
        public event Action<string, float> OnAbilityUsed;
        public event Action<Vector3> OnCriticalHit;
        #endregion

        /// <summary>
        /// Helper enum for card event types
        /// </summary>
        private enum CardEventType
        {
            Used,
            Drawn,
            Discarded
        }
        
        /// <summary>
        /// Subscribe to events
        /// </summary>
        private void OnEnable()
        {
            // Subscribe to any external events here
        }

        /// <summary>
        /// Unsubscribe from events
        /// </summary>
        private void OnDisable()
        {
            // Unsubscribe from any external events here
        }

        /// <summary>
        /// Update energy regeneration
        /// </summary>
        private void Update()
        {
            if (!_isInitialized)
                return;

            if (_playerEnergy < _maxPlayerEnergy)
            {
                float energyToAdd = _energyRegenRate * Time.deltaTime;
                _playerEnergy = Mathf.Min(_playerEnergy + energyToAdd, _maxPlayerEnergy);
            }
        }
        
        /// <summary>
        /// Initialize deck manager component
        /// </summary>
        private void InitializeDeckManager()
        {
            if (_deckManagerObject != null)
            {
                _deckManager = _deckManagerObject as IDeckManager;
                if (_deckManager == null)
                {
                    Debug.LogError("CardSystem: Deck manager object must implement IDeckManager interface");
                    return;
                }
                _isInitialized = true;
            }
            else
            {
                Debug.LogWarning("CardSystem: No deck manager assigned, will use fallback card generation");
                _isInitialized = true; // Still allow system to work with fallback
            }
        }
        
