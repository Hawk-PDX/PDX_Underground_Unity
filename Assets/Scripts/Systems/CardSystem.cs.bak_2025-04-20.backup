        public bool IsCardOnCooldown(ICard card) => IsCardOnCooldownImplementation(card);
        public List<ICard> GetCurrentHand() => new List<ICard>(_currentHand);
        public void DrawCard() => DrawCardImplementation(null);
        public void DrawCard(ICard card) => DrawCardImplementation(card);
        public void ShuffleDeck() => ShuffleDeckImplementation();
        public float GetAbilityCooldown(string abilityName) => GetAbilityCooldownImplementation(abilityName);
        
        // Additional public methods
        public void DrawCard(ICard card, Vector3 position)
        {
            DrawCardImplementation(card);
            // Additional position-based logic could be implemented here if needed
        }

        /// <summary>
        /// Use an ability by name, optionally with a direction
        /// </summary>
        private void UseAbility(string abilityName, Vector3? direction = null)
        {
            var card = _currentHand.FirstOrDefault(c => c.Name == abilityName);
            if (card != null)
            {
                if (direction.HasValue)
                {
                    UseCardImplementationWithDirection(card, direction.Value);
                }
                else
                {
                    UseCardImplementation(card);
                }
            }
            else
            {
                Debug.LogWarning($"CardSystem: No card found with ability name {abilityName}");
            }
        }

        public float GetEnergyCost(string abilityName)
        {
            var card = _currentHand.FirstOrDefault(c => c.Name == abilityName);
            return card?.EnergyCost ?? -1f;
        }

        public bool HasCard(string cardName)
        {
            return _currentHand.Any(c => c.Name == cardName);
        }

        public int GetHandSize()
        {
            return _currentHand.Count;
        }

        public int GetMaxHandSize()
        {
            return _maxHandSize;
        }

        private void UseCardByName(string cardName)
        {
            var card = _currentHand.FirstOrDefault(c => c.Name == cardName);
            if (card != null)
            {
                UseCardImplementation(card);
            }
            else
            {
                Debug.LogWarning($"CardSystem: No card found with name {cardName}");
            }
        }

        public List<string> GetAvailableAbilities()
        {
            return _currentHand.Select(card => card.Name).ToList();
        }

        public bool HasAbility(string abilityName)
        {
            return _currentHand.Any(c => c.Name == abilityName);
        }

        public float GetCurrentEnergy()
        {
            return _playerEnergy;
        }

        public float GetMaximumEnergy()
        {
            return _maxPlayerEnergy;
        }
        #endregion
        
        #region Implementation Methods
        // Private implementations
        private void UseCardImplementation(ICard card)
        {
            if (!IsCardPlayable(card))
            {
                Debug.LogWarning($"CardSystem: Card {card.Name} cannot be played (cooldown or energy)");
                return;
            }
            // Apply card effect
            UseCardEffect(card);

            // Update card state including event triggers
            UpdateCardAfterUse(card);
        }

        private bool UseCardImplementationWithBool(int cardIndex)
        {
            if (cardIndex < 0 || cardIndex >= _currentHand.Count)
                return false;
                
            var card = _currentHand[cardIndex];
            if (!IsCardPlayable(card))
                return false;
                
            UseCardEffect(card);
            UpdateCardAfterUse(card, cardIndex);
            return true;
        }

        private void UseCardImplementationWithDirection(ICard card, Vector3 direction)
        {
            if (!IsCardPlayable(card))
                return;
                
            UseCardEffectWithDirection(card, direction);
            UpdateCardAfterUse(card);
        }

        private void UseCardImplementationWithDirection(int cardIndex, Vector3 direction)
        {
            if (cardIndex < 0 || cardIndex >= _currentHand.Count)
                return;
                
            var card = _currentHand[cardIndex];
            if (!IsCardPlayable(card))
                return;
                
            UseCardEffectWithDirection(card, direction);
            UpdateCardAfterUse(card, cardIndex);
        }

        private bool UseCardImplementationWithDirectionAndBool(int cardIndex, Vector3 direction)
        {
            if (cardIndex < 0 || cardIndex >= _currentHand.Count)
                return false;
                
            var card = _currentHand[cardIndex];
            if (!IsCardPlayable(card))
                return false;
                
            UseCardEffectWithDirection(card, direction);
            UpdateCardAfterUse(card, cardIndex);
            return true;
        }
        
        private void UpdateCardAfterUse(ICard card, int? indexInHand = null)
        {
            if (card == null)
                return;
                
            // Update card state
            UpdateCardState(card);

            // Handle card removal if needed
            if (ShouldRemoveCardAfterUse(card))
            {
                if (indexInHand.HasValue && indexInHand >= 0 && indexInHand < _currentHand.Count)
                {
                    _currentHand.RemoveAt(indexInHand.Value);
                }
                else
                {
                    _currentHand.Remove(card);
                }
                TriggerCardEvents(card, CardEventType.Discarded);
            }
            
            // Trigger card used events
            TriggerCardEvents(card, CardEventType.Used);
            OnAbilityUsed?.Invoke(card.Name, card.Cooldown);
        }
        
        /// <summary>
        /// Updates the state of a card after use
        /// </summary>
        private void UpdateCardState(ICard card)
        {
            card.LastUseTime = Time.time;
            ModifyEnergy(-card.EnergyCost);
            _abilityCooldowns[card.Name] = Time.time;
        }
        
        /// <summary>
        /// Triggers appropriate events for card operations
        /// </summary>
        private void TriggerCardEvents(ICard card, CardEventType eventType)
        {
            switch (eventType)
            {
                case CardEventType.Used:
                    OnCardUsed?.Invoke(card);
                    break;
                case CardEventType.Drawn:
                    OnCardDrawn?.Invoke(card);
                    break;
                case CardEventType.Discarded:
                    OnCardDiscarded?.Invoke(card);
                    break;
            }
            // Always notify of hand changes for card operations
            // Create a new list for the event to maintain encapsulation
            OnHandChanged?.Invoke(new List<ICard>(_currentHand));
        }
        
        /// <summary>
        /// Check if a card can be used
        /// </summary>
        private bool IsCardPlayable(ICard card)
        {
            if (card == null)
                return false;
                
            return (Time.time - card.LastUseTime > card.Cooldown) && HasEnoughEnergy(card);
        }
        
        private void DiscardCardImplementation(ICard card)
        {
            if (card != null && _currentHand.Contains(card))
            {
                _currentHand.Remove(card);
                TriggerCardEvents(card, CardEventType.Discarded);
            }
        }
        
