        // Private implementations
        private void UseCardImplementation(ICard card)
        {
            if (!IsCardPlayable(card))
            {
                Debug.LogWarning($"CardSystem: Card {card.Name} cannot be played (cooldown or energy)");
                return;
            }
            // Apply card effect
            UseCardEffect(card);

            // Update card state including event triggers
            UpdateCardAfterUse(card);
        }

        private bool UseCardImplementationWithBool(int cardIndex)
        {
            if (cardIndex < 0 || cardIndex >= _currentHand.Count)
                return false;
                
            var card = _currentHand[cardIndex];
            if (!IsCardPlayable(card))
                return false;
                
            UseCardEffect(card);
            UpdateCardAfterUse(card, cardIndex);
            return true;
        }

        private void UseCardImplementationWithDirection(ICard card, Vector3 direction)
        {
            if (!IsCardPlayable(card))
                return;
                
            UseCardEffectWithDirection(card, direction);
