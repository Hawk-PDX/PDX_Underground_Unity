        private void UseAbility(string abilityName, Vector3? direction = null)
        {
            var card = _currentHand.FirstOrDefault(c => c.Name == abilityName);
            if (card != null)
            {
                if (direction.HasValue)
                {
                    UseCardImplementationWithDirection(card, direction.Value);
                }
                else
                {
                    UseCardImplementation(card);
                }
            }
