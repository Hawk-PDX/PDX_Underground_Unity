            return (Time.time - card.LastUseTime > card.Cooldown) && HasEnoughEnergy(card);
        }
        
        private void DiscardCardImplementation(ICard card)
        {
            if (card != null && _currentHand.Contains(card))
            {
                _currentHand.Remove(card);
                TriggerCardEvents(card, CardEventType.Discarded);
            }
        }
        
