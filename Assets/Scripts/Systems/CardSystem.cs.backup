        /// <summary>
        /// Draw a card from the deck to the hand
        /// </summary>
        public void DrawCard()
        {
            if (_currentHand.Count >= MaxHandSize)
            {
                Debug.LogWarning($"Hand is full ({_currentHand.Count}/{MaxHandSize}). Cannot draw more cards.");
                return;
            }

            if (_deckManager == null || _deckManager.GetAllCards().Count == 0)
            {
                Debug.LogWarning("Deck is empty. Cannot draw card.");
                return;
            }

            var card = _deckManager.DrawCard();
            if (card != null)
            {
                _currentHand.Add(card);
                OnCardDrawn?.Invoke(card);
                NotifyHandChanged();
                LogCardAction("Drew", card);
            }
        }

