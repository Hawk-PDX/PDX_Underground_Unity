        /// </summary>
        public void ShuffleDeck()
        {
            if (deck.Count <= 1)
            {
                return; // No need to shuffle a deck with 0 or 1 cards
            }

            deck = deck.OrderBy(x => random.Next()).ToList();
            UnityEngine.Debug.Log($"Deck shuffled - {deck.Count} cards");
        }

        /// <summary>
        /// Check if a card can be used (in hand and not on cooldown)
        /// </summary>
        /// <param name="card">The card to check</param>
        /// <returns>True if card can be used</returns>
        public bool CanUseCard(ICard card)
        {
            if (card == null)
            {
                return false;
            }
            return hand.Contains(card) && !IsCardOnCooldown(card);
        }

        /// <summary>
        /// Get the current cooldown time remaining for a specific card
        /// </summary>
        /// <param name="card">The card to check</param>
        /// <returns>Cooldown time in seconds, 0 if not on cooldown</returns>
        public float GetCardCooldown(ICard card)
        {
            if (card == null)
            {
                return 0f;
            }
            return cardCooldowns.TryGetValue(card, out float cooldown) ? cooldown : 0f;
        }

        /// <summary>
        /// Get the current cooldown time remaining for a specific ability
        /// </summary>
        /// <param name="abilityName">Name of the ability</param>
        /// <returns>Cooldown time in seconds, 0 if not on cooldown</returns>
        public float GetAbilityCooldown(string abilityName)
        {
            if (string.IsNullOrEmpty(abilityName))
            {
                return 0f;
            }
            return abilityCooldowns.TryGetValue(abilityName, out float cooldown) ? cooldown : 0f;
        }

        /// <summary>
        /// Check if a card is currently on cooldown
        /// </summary>
        /// <param name="card">The card to check</param>
        /// <returns>True if the card is on cooldown</returns>
        public bool IsCardOnCooldown(ICard card)
        {
            if (card == null)
            {
                return false;
            }
            return GetCardCooldown(card) > 0f;
        }

        /// <summary>
        /// Get a list of all cards currently in hand
        /// </summary>
        /// <returns>List of cards in hand</returns>
        public List<ICard> GetCurrentHand()
        {
            return new List<ICard>(hand);
        }
        #endregion

            
            // Apply ability cooldown if needed
            string abilityName = card.Type.ToString() + card.Id;
            abilityCooldowns[abilityName] = card.Cooldown;
            OnAbilityUsed?.Invoke(abilityName, card.Cooldown);
            
            // Fire events
            OnCardUsed?.Invoke(card);
            
            // Check for critical hit - for example, face cards (J, Q, K) might have critical effects
            if (IsCriticalHit(card))
            {
                OnCriticalHit?.Invoke(direction);
                UnityEngine.Debug.Log($"Critical hit with card {card.Name} in direction {direction}");
            }
            
            NotifyHandChanged();
            LogCardAction("Used", card);
        }

        /// <summary>
        /// Update all cooldowns each frame
        /// </summary>
        private void UpdateCooldowns()
        {
            var deltaTime = Time.deltaTime;

            // Update card cooldowns
            var cardKeys = new List<ICard>(cardCooldowns.Keys);
            foreach (var card in cardKeys)
            {
                if (cardCooldowns[card] > 0)
                {
                    cardCooldowns[card] -= deltaTime;
                    if (cardCooldowns[card] <= 0)
                    {
                        cardCooldowns.Remove(card);
                        UnityEngine.Debug.Log($"Card cooldown finished: {card.Name}");
                    }
                }
            }

            // Update ability cooldowns
            var abilityKeys = new List<string>(abilityCooldowns.Keys);
            foreach (var ability in abilityKeys)
            {
                if (abilityCooldowns[ability] > 0)
                {
                    abilityCooldowns[ability] -= deltaTime;
                    if (abilityCooldowns[ability] <= 0)
                    {
                        abilityCooldowns.Remove(ability);
                        UnityEngine.Debug.Log($"Ability cooldown finished: {ability}");
                    }
                }
            }
        }

        /// <summary>
        /// Determine if a card results in a critical hit
        /// </summary>
        /// <param name="card">The card to check</param>
        /// <returns>True if the card is a critical hit</returns>
        private bool IsCriticalHit(ICard card)
        {
            if (card == null)
            {
                return false;
            }
            
            // Example: Face cards (11, 12, 13) have a chance for critical hits
            if (card.Rank >= 11 && card.Rank <= 13)
            {
                // 30% chance for critical on face cards
                return UnityEngine.Random.value < 0.3f;
            }
            
            // Aces (rank 1) always critical
            if (card.Rank == 1)
            {
                return true;
            }
            
            return false;
        }

        /// <summary>
        /// Notify that the hand has changed
        /// </summary>
        private void NotifyHandChanged()
        {
            OnHandChanged?.Invoke(GetCurrentHand());
        }
