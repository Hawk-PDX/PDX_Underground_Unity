                    }
                },
                {
                    Flick,
                    new CardDefinition
                    {
                        Name = Flick,
                        Type = CardType.Attack,
                        EnergyCost = 1f,
                        Cooldown = 1f,
                        Damage = 5f,
                        Description = "A rapid card throw",
                        SpecialEffect = SpecialEffect.None
                    }
                },
                {
                    DealersChoice,
                    new CardDefinition
                    {
                        Name = DealersChoice,
                        Type = CardType.Special,
                        EnergyCost = 5f,
                        Cooldown = 15f,
                        Damage = 0f,
                        Description = "Deal 5 cards and gain power based on hand value",
                        SpecialEffect = SpecialEffect.DealersChoice
                    }
                }
            };
        }
        
        // Energy management
        private float _playerEnergy = 100f;
        private float _maxPlayerEnergy = 100f;
        private float _energyRegenRate = 10f;

        #region Properties
        // Properties that implement interface requirements
        public ICard[] CurrentHand => _currentHand.ToArray();
        public ICard[] Deck => _deckManager?.GetAllCards()?.ToArray() ?? Array.Empty<ICard>();
        public int MaxHandSize => _maxHandSize;
        #endregion

        #region Events
        // Public event declarations that implement interface requirements
        public event Action<ICard> OnCardUsed;
        public event Action<ICard> OnCardDrawn;
        public event Action<ICard> OnCardDiscarded;
        public event Action<List<ICard>> OnHandChanged;
        
        #region Initialization
        
        private void Start()
        {
            InitializeDeck(startingDeck.ConvertAll(card => (ICard)card));
            ShuffleDeck();
            DrawInitialHand();
        }
        
        private void InitializeDeck(List<ICard> cards)
        {
            deck.Clear();
            deck.AddRange(cards);
        }
        
        private void DrawInitialHand()
        {
            for (int i = 0; i < initialHandSize; i++)
            {
                DrawCardInternal();
            }
        }
        #endregion
        
        #region Public Interface
        
        public ICard[] CurrentHand => hand.ToArray();
        public ICard[] Deck => deck.ToArray();
        public int MaxHandSize => maxHandSize;
        
        public void ShuffleDeck()
        {
            // Fisher-Yates shuffle
            for (int i = deck.Count - 1; i > 0; i--)
            {
                int j = UnityEngine.Random.Range(0, i + 1);
                ICard temp = deck[i];
                deck[i] = deck[j];
                deck[j] = temp;
            }
        }
        
        public void UseCard(ICard card)
        {
            if (card == null || !CanUseCard(card)) return;
            
            card.LastUseTime = Time.time;
            hand.Remove(card);
            discardPile.Add(card);
            
            OnCardUsed?.Invoke(card);
            OnCardDiscarded?.Invoke(card);
            OnHandChanged?.Invoke(hand);
        }
        
        public ICard DrawCard()
        {
            return DrawCardInternal();
        }
        #endregion
        
        #region Helper Methods
        
        private ICard DrawCardInternal()
        {
            if (hand.Count >= maxHandSize) return null;
            
            // Reshuffle discard pile if deck is empty
            if (deck.Count == 0 && discardPile.Count > 0)
            {
                deck.AddRange(discardPile);
                discardPile.Clear();
                ShuffleDeck();
            }
            
            if (deck.Count == 0) return null;
            
            ICard drawnCard = deck[0];
            deck.RemoveAt(0);
            hand.Add(drawnCard);
            
            OnCardDrawn?.Invoke(drawnCard);
            OnHandChanged?.Invoke(hand);
            
            return drawnCard;
        }
        
        private bool CanUseCard(ICard card)
        {
            if (card == null) return false;
            return !IsCardOnCooldown(card);
        }
        
        private bool IsCardOnCooldown(ICard card)
        {
            float timeSinceUse = Time.time - card.LastUseTime;
            return timeSinceUse < card.Cooldown;
        }
        #endregion
    }
}

