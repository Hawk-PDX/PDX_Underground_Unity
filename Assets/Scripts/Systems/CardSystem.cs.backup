using UnityEngine;
using System;
using System.Collections.Generic;
using System.Linq;
using PDXUnderground.Core;
using PDXUnderground.Core.Interfaces;
using PDXUnderground.Models;
using PDXUnderground.Models.Interfaces;

namespace PDXUnderground.Systems
{
    /// <summary>
    /// Manages all card gameplay including drawing, usage, and hand management
    /// Implements both ICardSystem and ICardController interfaces
    /// </summary>
    [AddComponentMenu("PDX Underground/Card System")]
    public class CardSystem : MonoBehaviour, ICardSystem, ICardController
    {
        #region Fields
        [Header("Card Settings")]
        [SerializeField] private int _maxHandSize = 5;
        
        [Header("Energy Settings")]
        [SerializeField] private float _maxPlayerEnergy = 100f;
        [SerializeField] private float _energyRegenRate = 10f;

        private readonly List<ICard> _currentHand = new();
        private IDeckManager _deckManager;
        private float _playerEnergy;
        private readonly Dictionary<string, float> _abilityCooldowns = new();
        private bool _isInitialized;

        /// <summary>
        /// Gambler abilities with their configurations
        /// </summary>
        private static class GamblerAbilities
        {
            public const string Slice = "Slice";
            public const string Flick = "Flick";
            public const string DealersChoice = "Dealer's Choice";

            public static readonly Dictionary<string, CardDefinition> Abilities = new()
            {
                {
                    Slice,
                    new CardDefinition
                    {
                        Name = Slice,
                        Type = CardType.Attack,
                        EnergyCost = 2f,
                        Cooldown = 1.5f,
                        Damage = 8f,
                        Description = "A quick slash attack",
                        SpecialEffect = SpecialEffect.None
                    }
                },
                {
                    Flick,
                    new CardDefinition
                    {
                        Name = Flick,
                        Type = CardType.Attack,
                        EnergyCost = 1f,
                        Cooldown = 1f,
                        Damage = 5f,
                        Description = "A rapid card throw",
                        SpecialEffect = SpecialEffect.None
                    }
                },
                {
                    DealersChoice,
                    new CardDefinition
                    {
                        Name = DealersChoice,
                        Type = CardType.Special,
                        EnergyCost = 5f,
                        Cooldown = 15f,
                        Damage = 0f,
                        Description = "Deal 5 cards and gain power based on hand value",
                        SpecialEffect = SpecialEffect.DealersChoice
                    }
                }
            };
        }
        #endregion

        #region Properties
        public ICard[] CurrentHand => _currentHand.ToArray();
        public ICard[] Deck => _deckManager?.GetAllCards()?.ToArray() ?? Array.Empty<ICard>();
        public int MaxHandSize => _maxHandSize;
        public float CurrentEnergy => _playerEnergy;
        #endregion

        #region Events
        public event Action<ICard> OnCardUsed;
        public event Action<ICard> OnCardDrawn;
        public event Action<ICard> OnCardDiscarded;
        public event Action<List<ICard>> OnHandChanged;
        public event Action<string, float> OnAbilityUsed;
        public event Action<Vector3> OnCriticalHit;
        #endregion

        #region Unity Lifecycle
        private void Start()
        {
            InitializeDeckManager();
            _playerEnergy = _maxPlayerEnergy;
        }

        private void Update()
        {
            if (!_isInitialized) return;
            
            // Handle energy regeneration
            HandleEnergyRegeneration();
        }
        #endregion

        #region Public Interface
        public void UseCard(ICard card) => UseCardImplementation(card);
        public bool UseCard(int cardIndex) => cardIndex >= 0 && cardIndex < _currentHand.Count && 
            UseCardImplementation(_currentHand[cardIndex]);
            
        public void DiscardCard(ICard card)
        {
            if (card == null || !_currentHand.Contains(card)) return;
            _currentHand.Remove(card);
            OnCardDiscarded?.Invoke(card);
            OnHandChanged?.Invoke(new List<ICard>(_currentHand));
        }

        public bool CanUseCard(ICard card) => IsCardPlayable(card);

        public void DrawCard() => DrawCardImplementation(null);
        #endregion

        #region Helper Methods
        private bool UseCardImplementation(ICard card)
        {
            if (!IsCardPlayable(card)) return false;

            HandleCardEffect(card);
            UpdateCardState(card);
            
            OnCardUsed?.Invoke(card);
            OnHandChanged?.Invoke(new List<ICard>(_currentHand));
            return true;
        }

        private bool IsCardPlayable(ICard card)
        {
            return card != null && 
                   _currentHand.Contains(card) &&
                   Time.time - card.LastUseTime >= card.Cooldown &&
                   _playerEnergy >= card.EnergyCost;
        }

        private void DrawCardImplementation(ICard card)
        {
            if (_currentHand.Count >= _maxHandSize) return;

            ICard drawnCard = card ?? _deckManager?.DrawCard() ?? GenerateCard();
            if (drawnCard != null)
            {
                _currentHand.Add(drawnCard);
                OnCardDrawn?.Invoke(drawnCard);
                OnHandChanged?.Invoke(new List<ICard>(_currentHand));
            }
        }

        private void HandleEnergyRegeneration()
        {
            if (_playerEnergy < _maxPlayerEnergy)
            {
                _playerEnergy = Mathf.Min(_playerEnergy + _energyRegenRate * Time.deltaTime, _maxPlayerEnergy);
            }
        }

        private void UpdateCardState(ICard card)
        {
            card.LastUseTime = Time.time;
            _playerEnergy -= card.EnergyCost;
            _abilityCooldowns[card.Name] = card.Cooldown;
        }

        private ICard GenerateCard()
        {
            // Card generation logic
            return null;
        }

        private void InitializeDeckManager()
        {
            _deckManager = GetComponent<IDeckManager>();
            _isInitialized = _deckManager != null;
        }

        private void HandleCardEffect(ICard card)
        {
            if (card.Name == GamblerAbilities.DealersChoice)
            {
                // Handle Dealer's Choice special logic
            }
        }
        #endregion

        /// <summary>
        /// Definition structure for card abilities
        /// </summary>
        public class CardDefinition
        {
            public string Name { get; set; }
            public CardType Type { get; set; }
            public float EnergyCost { get; set; }
            public float Cooldown { get; set; }
            public float Damage { get; set; }
            public string Description { get; set; }
            public SpecialEffect SpecialEffect { get; set; } = SpecialEffect.None;
        }
    }
}

using UnityEngine;
using System;
using System.Collections.Generic;
using System.Linq;
using PDXUnderground.Core;
using PDXUnderground.Core.Interfaces;
using PDXUnderground.Models;
using PDXUnderground.Models.Interfaces;
using ICard = PDXUnderground.Models.Interfaces.ICard;

namespace PDXUnderground.Systems
{
    /// <summary>
    /// Unified implementation of the card system that handles all card operations
    /// including drawing, using, and managing card states and cooldowns.
    /// Implements both ICardSystem and ICardController interfaces.
    /// </summary>
    [AddComponentMenu("PDX Underground/Card System")]
    public class CardSystem : MonoBehaviour, ICardSystem, ICardController
    {
        #region Fields
        [Header("Card Management")]
        [SerializeField] private int _maxHandSize = 5;
        
        private List<ICard> _currentHand = new List<ICard>();
        private IDeckManager _deckManager;
        
        [Header("Energy System")] 
        [SerializeField] private float _maxPlayerEnergy = 100f;
        [SerializeField] private float _energyRegenRate = 10f;
        private float _playerEnergy;

        private Dictionary<string, float> _abilityCooldowns = new Dictionary<string, float>();
        private bool _isInitialized = false;
        #endregion

        #region Properties
        public ICard[] CurrentHand => _currentHand.ToArray();
        public ICard[] Deck => _deckManager?.GetAllCards()?.ToArray() ?? Array.Empty<ICard>();
        public int MaxHandSize => _maxHandSize;
        public float CurrentEnergy => _playerEnergy;
        #endregion

        #region Events
        public event Action<ICard> OnCardUsed;
        public event Action<ICard> OnCardDrawn;
        public event Action<ICard> OnCardDiscarded;
        public event Action<List<ICard>> OnHandChanged;
        public event Action<string, float> OnAbilityUsed;
        #endregion

        #region Unity Lifecycle
        private void Start()
        {
            InitializeDeckManager();
            _playerEnergy = _maxPlayerEnergy;
        }

        private void Update()
        {
            if (!_isInitialized) return;
            
            // Handle energy regeneration
            if (_playerEnergy < _maxPlayerEnergy)
            {
                _playerEnergy = Mathf.Min(_playerEnergy + _energyRegenRate * Time.deltaTime, _maxPlayerEnergy);
            }
        }
        #endregion

        #region Public Interface
        public void UseCard(ICard card) => UseCardImplementation(card);
        public bool UseCard(int cardIndex) => cardIndex >= 0 && cardIndex < _currentHand.Count && 
            UseCardImplementation(_currentHand[cardIndex]);
            
        public void DiscardCard(ICard card)
        {
            if (card == null || !_currentHand.Contains(card)) return;
            _currentHand.Remove(card);
            OnCardDiscarded?.Invoke(card);
            OnHandChanged?.Invoke(new List<ICard>(_currentHand));
        }

        public bool CanUseCard(ICard card) => IsCardPlayable(card);

        public void DrawCard() => DrawCardImplementation(null);
        #endregion

        #region Helper Methods
        private bool UseCardImplementation(ICard card)
        {
            if (!IsCardPlayable(card)) return false;

            // Apply card effect
            HandleCardEffect(card);

            // Update state
            card.LastUseTime = Time.time;
            _playerEnergy -= card.EnergyCost;
            _abilityCooldowns[card.Name] = card.Cooldown;

            OnCardUsed?.Invoke(card);
            OnHandChanged?.Invoke(new List<ICard>(_currentHand));
            return true;
        }

        private bool IsCardPlayable(ICard card)
        {
            return card != null && 
                   _currentHand.Contains(card) &&
                   Time.time - card.LastUseTime >= card.Cooldown &&
                   _playerEnergy >= card.EnergyCost;
        }

        private void DrawCardImplementation(ICard card)
        {
            if (_currentHand.Count >= _maxHandSize) return;

            ICard drawnCard = card ?? _deckManager?.DrawCard() ?? GenerateCard();
            if (drawnCard != null)
            {
                _currentHand.Add(drawnCard);
                OnCardDrawn?.Invoke(drawnCard);
                OnHandChanged?.Invoke(new List<ICard>(_currentHand));
            }
        }

        private void HandleCardEffect(ICard card)
        {
            // Handle different card effects based on type
            switch (card.Type)
            {
                case CardType.Attack:
                    // Process attack
                    break;
                    
                case CardType.Special:
                    // Process special abilities
                    break;
                    
                // Other card type handlers
            }
        }

        private ICard GenerateCard()
        {
            // Card generation logic
            return null;
        }

        private void InitializeDeckManager()
        {
            _deckManager = GetComponent<IDeckManager>();
            _isInitialized = _deckManager != null;
        }
        #endregion
    }
}

