        /// <summary>
        /// Update energy regeneration and cooldowns
        /// </summary>
        private void Update()
        {
            if (!_isInitialized)
                return;
                
            // Energy regeneration
            if (_playerEnergy < _maxPlayerEnergy)
            {
                float energyToAdd = _energyRegenRate * Time.deltaTime;
                _playerEnergy = Mathf.Min(_playerEnergy + energyToAdd, _maxPlayerEnergy);
            }
            
            // Update cooldowns
            UpdateCooldowns();
        }
        #endregion
        
        #region Initialization Methods
        /// <summary>
