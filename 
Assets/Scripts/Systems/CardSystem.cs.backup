        /// <summary>
        /// Update energy regeneration
        /// </summary>
    private void Update()
    {
        if (!_isInitialized) return;
        
        // Energy regeneration
        if (_playerEnergy < _maxPlayerEnergy)
        {
            float energyToAdd = _energyRegenRate * _fixedDeltaTime;
                _playerEnergy = Mathf.Min(_playerEnergy + energyToAdd, _maxPlayerEnergy);
            }
        }
        
